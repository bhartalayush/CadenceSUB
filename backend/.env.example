# Cadence Executive AI Email Engine - Configuration

# Choose your AI Provider: 'gemini' | 'openai' | 'embedded'
AI_PROVIDER=gemini

# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=

# Or OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Server Port
PORT=5000
